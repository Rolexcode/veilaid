// VeilAid — private student-aid eligibility on Midnight.
//
// The public ledger stores only credential commitments, one-time nullifiers,
// and aggregate counters. Enrollment status, household income, and the
// student's secret never leave the prover's private state.

pragma language_version 0.23;

import CompactStandardLibrary;

export ledger issuerKey: Bytes<32>;
export ledger issuedCredentials: Set<Bytes<32>>;
export ledger usedNullifiers: Set<Bytes<32>>;
export ledger issuedCount: Counter;
export ledger approvedClaimCount: Counter;

constructor(initialIssuerKey: Bytes<32>) {
  issuerKey = disclose(initialIssuerKey);
}

// Private values supplied locally by the institution or applicant.
witness localIssuerSecret(): Bytes<32>;
witness localStudentSecret(): Bytes<32>;
witness localEnrollmentStatus(): Uint<64>;
witness localHouseholdIncome(): Uint<64>;
witness localCredentialNonce(): Bytes<32>;

export circuit issuerPublicKey(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "veilaid:issuer"),
    secret
  ]);
}

export circuit credentialCommitment(
  studentSecret: Bytes<32>,
  enrollmentStatus: Uint<64>,
  householdIncome: Uint<64>,
  credentialNonce: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "veilaid:credential"),
    studentSecret,
    enrollmentStatus as Bytes<32>,
    householdIncome as Bytes<32>,
    credentialNonce
  ]);
}

// The demo institution issues a commitment. The underlying student record is
// used inside the proof and is never written to public state.
export circuit issueCredential(
  studentSecret: Bytes<32>,
  enrollmentStatus: Uint<64>,
  householdIncome: Uint<64>,
  credentialNonce: Bytes<32>
): [] {
  assert(
    disclose(issuerPublicKey(localIssuerSecret()) == issuerKey),
    "Only the approved institution can issue credentials"
  );

  const commitment = credentialCommitment(
    studentSecret,
    enrollmentStatus,
    householdIncome,
    credentialNonce
  );

  assert(
    !issuedCredentials.member(disclose(commitment)),
    "Credential has already been issued"
  );
  issuedCredentials.insert(disclose(commitment));
  issuedCount.increment(1);
}

// A student proves enrollment and an income threshold from private local
// values. The grant ID scopes the nullifier so one credential may be used once
// per grant, without making separate grant applications linkable.
export circuit claimGrant(grantId: Bytes<32>, maximumIncome: Uint<64>): [] {
  const studentSecret = localStudentSecret();
  const enrollmentStatus = localEnrollmentStatus();
  const householdIncome = localHouseholdIncome();
  const credentialNonce = localCredentialNonce();

  assert(
    disclose(enrollmentStatus == 1),
    "Applicant is not currently enrolled"
  );
  assert(
    disclose(householdIncome <= maximumIncome),
    "Applicant does not meet this grant's income rule"
  );

  const commitment = credentialCommitment(
    studentSecret,
    enrollmentStatus,
    householdIncome,
    credentialNonce
  );
  assert(
    issuedCredentials.member(disclose(commitment)),
    "No credential from the approved institution was found"
  );

  const nullifier = persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "veilaid:claim"),
    grantId,
    studentSecret,
    credentialNonce
  ]);
  assert(
    !usedNullifiers.member(disclose(nullifier)),
    "This credential has already claimed this grant"
  );

  usedNullifiers.insert(disclose(nullifier));
  approvedClaimCount.increment(1);
}
